# ═══════════════════════════════════════════════════════════════════
#  EMAOS - Enterprise Multi-Agent AI Operating System
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ─── LLM (Required) ───────────────────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── GitHub (Required for Developer Agent) ────────────────────────
# Settings -> Developer settings -> Personal access tokens -> Generate new token
# Scopes: repo, workflow, read:org, pull_requests
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO_OWNER=your_github_username
GITHUB_DEFAULT_REPO=your_default_repo_name

# ─── JWT Authentication (Required) ────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256

# ─── Web Search (Optional, falls back to Mock Search) ──────────────
# Get key at: https://tavily.com
TAVILY_API_KEY=optional_tavily_key_here

# ─── Auth credentials (Optional) ──────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=emaos_admin_2024
