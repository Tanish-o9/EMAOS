# ════════════════════════════════════════════════════════════════════
#  EMAOS — Enterprise Multi-Agent AI Operating System
#  Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════════════

# ─── LLM (Required) ──────────────────────────────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_BJXbnDlro5SQ7fWnWaDpWGdyb3FYjom1hsNPmFV21iXwNgWYdsHKyour_groq_api_key_here

# Primary model (free, fastest)
GROQ_MODEL=llama-3.3-70b-versatile

# ─── GitHub (Required for Developer Agent) ───────────────────────────────────
# Settings → Developer settings → Personal access tokens → Generate new token
# Scopes: repo, workflow, read:org, pull_requests
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO_OWNER=your_github_username
GITHUB_DEFAULT_REPO=your_default_repo_name

# ─── JWT Authentication (Required) ───────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database (Self-hosted via Docker) ───────────────────────────────────────
DATABASE_URL=postgresql://emaos:emaos_secret@localhost:5432/emaos
POSTGRES_DB=emaos
POSTGRES_USER=emaos
POSTGRES_PASSWORD=emaos_secret

# ─── Redis (Self-hosted via Docker) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Tavily Web Search (Optional - better search) ────────────────────────────
# Get free key at: https://tavily.com
TAVILY_API_KEY=optional_tavily_key_here

# ─── Hugging Face (Optional - for advanced embeddings) ───────────────────────
# Get at: https://huggingface.co/settings/tokens
HF_TOKEN=optional_hf_token_here

# ─── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── FastAPI ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ─── Admin credentials (for dashboard login) ─────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=emaos_admin_2024
